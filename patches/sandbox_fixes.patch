--- a/internal/core/lib/seccomp.go
+++ b/internal/core/lib/seccomp.go
@@ -12,6 +12,8 @@ import (
 	sg "github.com/seccomp/libseccomp-golang"
 )
 
+const sysClone3 = 435
+
 func Seccomp(allowed_syscalls []int, allowed_not_kill_syscalls []int) error {
 	ctx, err := sg.NewFilter(sg.ActKillProcess)
 	if err != nil {
@@ -25,24 +27,49 @@ func Seccomp(allowed_syscalls []int, allowed_not_kill_syscalls []int) error {
 	defer reader.Close()
 	defer writer.Close()
 
-	for _, syscall := range allowed_syscalls {
-		ctx.AddRule(sg.ScmpSyscall(syscall), sg.ActAllow)
+	for _, sc := range allowed_syscalls {
+		ctx.AddRule(sg.ScmpSyscall(sc), sg.ActAllow)
+	}
+
+	// Allow thread naming (PR_SET_NAME=15, PR_GET_NAME=16) needed by libuv/Node.js workers.
+	for _, prctlOp := range []uint64{15, 16} {
+		if cond, cerr := sg.MakeCondition(0, sg.CompareEqual, prctlOp); cerr == nil {
+			ctx.AddRuleConditional(sg.ScmpSyscall(syscall.SYS_PRCTL), sg.ActAllow, []sg.ScmpCondition{cond})
+		}
 	}
 
-	for _, syscall := range allowed_not_kill_syscalls {
-		ctx.AddRule(sg.ScmpSyscall(syscall), sg.ActErrno)
+	for _, sc := range allowed_not_kill_syscalls {
+		if sc == syscall.SYS_CLONE {
+			// Allow thread creation (CLONE_THREAD) inside the already-jailed chroot/uid/seccomp process
+			// (needed by Node.js libuv DNS/TLS threadpool), while returning EPERM for fork().
+			cond, cerr := sg.MakeCondition(0, sg.CompareMaskedEqual, uint64(syscall.CLONE_THREAD), uint64(syscall.CLONE_THREAD))
+			if cerr == nil {
+				ctx.AddRuleConditional(sg.ScmpSyscall(sc), sg.ActAllow, []sg.ScmpCondition{cond})
+			}
+			condFork, cerr2 := sg.MakeCondition(0, sg.CompareMaskedEqual, uint64(syscall.CLONE_THREAD), 0)
+			if cerr2 == nil {
+				ctx.AddRuleConditional(sg.ScmpSyscall(sc), sg.ActErrno.SetReturnCode(int16(syscall.EPERM)), []sg.ScmpCondition{condFork})
+			} else {
+				ctx.AddRule(sg.ScmpSyscall(sc), sg.ActErrno.SetReturnCode(int16(syscall.EPERM)))
+			}
+			continue
+		}
+		if sc == sysClone3 {
+			// Return ENOSYS for clone3 so glibc falls back cleanly to clone(CLONE_THREAD|...).
+			ctx.AddRule(sg.ScmpSyscall(sc), sg.ActErrno.SetReturnCode(int16(syscall.ENOSYS)))
+			continue
+		}
+		ctx.AddRule(sg.ScmpSyscall(sc), sg.ActErrno.SetReturnCode(int16(syscall.EPERM)))
 	}
 
 	file := os.NewFile(uintptr(writer.Fd()), "pipe")
 	ctx.ExportBPF(file)
 
-	// read from pipe
 	data := make([]byte, 4096)
 	n, err := reader.Read(data)
 	if err != nil {
 		return err
 	}
-	// load bpf
 	sock_filters := make([]syscall.SockFilter, n/8)
 	bytesBuffer := bytes.NewBuffer(data)
 	err = binary.Read(bytesBuffer, binary.LittleEndian, &sock_filters)
